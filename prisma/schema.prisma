generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Partner {
  id            Int      @id @default(autoincrement())
  category      String
  competition   String
  organizer     String?  @default("")
  level         String?  @default("")
  deadline      String?  @default("")
  link          String?  @default("")
  teamSize      String?  @default("")
  slots         Int?
  roles         Json
  scope         String?  @default("")
  description   String?  @default("")
  contactType   String   @default("WhatsApp")
  contact       String
  ownerName     String?  @default("")
  ownerCampus   String?  @default("")
  ownerUsername String
  ownerPhoto    String?  @default("")
  createdAt     DateTime @default(now())
  joins         Join[]
}

model Join {
  id        Int      @id @default(autoincrement())
  partnerId Int
  name      String
  username  String
  status    String   @default("menunggu")
  createdAt DateTime @default(now())
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
}

model Profile {
  username  String   @id
  name      String   @default("")
  campus    String   @default("")
  major     String   @default("")
  contact   String   @default("")
  bio       String   @default("")
  photo     String?  @default("")
  looking   Boolean  @default(true)
  interests Json     @default("[]")
  skills    Json     @default("[]")
  history   Json     @default("[]")
  updatedAt DateTime @updatedAt
}

model User {
  id           Int             @id @default(autoincrement())
  username     String          @unique
  email        String          @unique
  name         String
  passwordHash String
  createdAt    DateTime        @default(now())
  resets       PasswordReset[]
  sessions     Session[]
}

model Session {
  id         String   @id
  userId     Int
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id        String    @id
  userId    Int
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
